# Скопируйте в .env и вставьте ключ: cp .env.example .env
# Ключ нужен только ассистенту; склад работает и без него.
OPENAI_API_KEY=

# Основная и запасная модели (Responses API). Запасная отвечает, если основная недоступна:
# 429/5xx, таймаут, обрыв до начала ответа, нет такой модели или доступа к ней.
LLM_PRIMARY_MODEL=gpt-4.1-mini
LLM_FALLBACK_MODEL=gpt-4o-mini
# Судья эталонного прогона — другая модель, чем та, что отвечает (не проверяет сама себя).
LLM_JUDGE_MODEL=gpt-4o
# Потолок на один шаг модели (с Code Interpreter) и на паузу между событиями стрима, секунды.
LLM_TIMEOUT_S=300
LLM_IDLE_TIMEOUT_S=90

# Секрет подписи JWT — длинная случайная строка (openssl rand -hex 32). Пусто или значение-заглушка —
# бэкенд при старте сгенерирует случайный секрет (вход сбросится после перезапуска). На сервере обязателен.
JWT_SECRET=

# Поведение мок-сервиса маркировки (доля 500-х, доля медленных ответов, задержка, с)
MARKING_FAILURE_RATE=0.3
MARKING_SLOW_RATE=0.1
MARKING_SLOW_SECONDS=10

# --- Только для сервера (docker-compose.prod.yml) ---
# Домен, который смотрит на сервер (A-запись в DNS). Caddy сам получит HTTPS-сертификат.
DOMAIN=
# Лимиты ассистента на публичном стенде: сообщений в час на пользователя и всего за сутки (0 — без лимита).
CHAT_USER_HOURLY_LIMIT=0
CHAT_DAILY_LIMIT=0
